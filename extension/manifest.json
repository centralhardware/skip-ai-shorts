{
  "manifest_version": 3,
  "name": "Skip AI Shorts",
  "version": "1.1.3",
  "description": "Skips YouTube Shorts that carry YouTube's altered/synthetic (AI) content label.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Skip AI Shorts",
    "default_popup": "popup.html"
  }
}
