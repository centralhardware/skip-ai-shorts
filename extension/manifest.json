{
  "manifest_version": 3,
  "name": "Skip AI Shorts",
  "version": "1.2.2",
  "description": "Skips YouTube Shorts that carry YouTube's altered/synthetic (AI) content label.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js",
        "loader.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Skip AI Shorts",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ]
    }
  ]
}
